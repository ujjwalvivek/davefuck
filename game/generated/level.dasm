macro check_exit
  ifz GAME_DEAD
    ifz GAME_WIN
      ifeq CURRENT_LEVEL 1
        ifeq PLAYER_X 12
          ifeq PLAYER_Y 8
            ifnz DOOR_OPEN
              set CURRENT_LEVEL 2
              clear DOOR_OPEN
              clear KEY_COLLECTED
              set PLAYER_X 1
              set PLAYER_Y 8
              clear PLAYER_SUB_X
              clear PLAYER_SUB_Y
              clear PLAYER_JUMP_PHASE
              clear PLAYER_JUMP_TIMER
              clear PROJECTILE_ACTIVE
              clear PROJECTILE_X
              clear PROJECTILE_Y
              clear PROJECTILE_DIR
              call reset_coins
              call reset_enemy
              call reset_flying_enemy
              call audio AUDIO_DOOR
            end
          end
        end
      end
      ifeq CURRENT_LEVEL 2
        ifeq PLAYER_X 46
          ifeq PLAYER_Y 1
            ifnz DOOR_OPEN
              set CURRENT_LEVEL 3
              clear DOOR_OPEN
              clear KEY_COLLECTED
              set PLAYER_X 1
              set PLAYER_Y 5
              clear PLAYER_SUB_X
              clear PLAYER_SUB_Y
              clear PLAYER_JUMP_PHASE
              clear PLAYER_JUMP_TIMER
              clear PROJECTILE_ACTIVE
              clear PROJECTILE_X
              clear PROJECTILE_Y
              clear PROJECTILE_DIR
              call reset_coins
              call reset_enemy
              call reset_flying_enemy
              call audio AUDIO_DOOR
            end
          end
        end
      end
      ifeq CURRENT_LEVEL 3
        ifeq PLAYER_X 75
          ifeq PLAYER_Y 1
            ifnz DOOR_OPEN
              set GAME_WIN 1
              call audio AUDIO_WIN
            end
          end
        end
      end
    end
  end
end

macro check_enemy_projectile_hit
  ifz GAME_DEAD
    ifz GAME_WIN
      ifnz ENEMY_PROJ1_ACTIVE
        clear COLLISION_BLOCKED
        ifeq_cell PLAYER_X ENEMY_PROJ1_X
          set COLLISION_BLOCKED 1
        end
        inc PLAYER_X
        ifeq_cell PLAYER_X ENEMY_PROJ1_X
          ifeq PLAYER_SUB_X 8
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 9
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 10
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 11
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 12
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 13
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 14
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 15
            set COLLISION_BLOCKED 1
          end
        end
        dec PLAYER_X
        ifnz COLLISION_BLOCKED
          ifeq_cell PLAYER_Y ENEMY_PROJ1_Y
            set GAME_DEAD 1
            call audio AUDIO_DEATH
          end
        end
        clear COLLISION_BLOCKED
      end
      ifnz ENEMY_PROJ2_ACTIVE
        clear COLLISION_BLOCKED
        ifeq_cell PLAYER_X ENEMY_PROJ2_X
          set COLLISION_BLOCKED 1
        end
        inc PLAYER_X
        ifeq_cell PLAYER_X ENEMY_PROJ2_X
          ifeq PLAYER_SUB_X 8
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 9
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 10
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 11
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 12
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 13
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 14
            set COLLISION_BLOCKED 1
          end
          ifeq PLAYER_SUB_X 15
            set COLLISION_BLOCKED 1
          end
        end
        dec PLAYER_X
        ifnz COLLISION_BLOCKED
          ifeq_cell PLAYER_Y ENEMY_PROJ2_Y
            set GAME_DEAD 1
            call audio AUDIO_DEATH
          end
        end
        clear COLLISION_BLOCKED
      end
    end
  end
end

macro tick_enemy_projectiles
  ifz FLYING_ENEMY_DEAD
    ifnz FLYING_ENEMY_SHOOT_TIMER
      dec FLYING_ENEMY_SHOOT_TIMER
    end
    ifz FLYING_ENEMY_SHOOT_TIMER
      set FLYING_ENEMY_SHOOT_TIMER 150
      clear ENEMY_PROJ1_SHOOT_OK
      set ENEMY_PROJ1_DIR 1
      ifeq CURRENT_LEVEL 3
        ifeq PLAYER_X 25
          set ENEMY_PROJ1_SHOOT_OK 1
