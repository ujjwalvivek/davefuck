  ifnz ENEMY_PROJ_MOVE_TIMER
    dec ENEMY_PROJ_MOVE_TIMER
  end
  ifz ENEMY_PROJ_MOVE_TIMER
    set ENEMY_PROJ_MOVE_TIMER 3
    ifnz ENEMY_PROJ1_ACTIVE
      ifnz ENEMY_PROJ1_DIR
        inc ENEMY_PROJ1_X
      end
      ifz ENEMY_PROJ1_DIR
        ifz ENEMY_PROJ1_X
          clear ENEMY_PROJ1_ACTIVE
        end
        ifnz ENEMY_PROJ1_X
          dec ENEMY_PROJ1_X
        end
      end
      ifnz ENEMY_PROJ1_ACTIVE
        copy PROJECTILE_X BACKUP_PROJ_X
        copy PROJECTILE_Y BACKUP_PROJ_Y
        copy ENEMY_PROJ1_X PROJECTILE_X
        copy ENEMY_PROJ1_Y PROJECTILE_Y
