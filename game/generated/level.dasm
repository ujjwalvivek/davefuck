          set ENEMY_PROJ1_SHOOT_OK 1
        end
        ifeq PLAYER_X 45
          set ENEMY_PROJ1_SHOOT_OK 1
        end
      end
      ifnz ENEMY_PROJ1_SHOOT_OK
        ifz ENEMY_PROJ1_ACTIVE
          set ENEMY_PROJ1_ACTIVE 1
          copy FLYING_ENEMY_X ENEMY_PROJ1_X
          copy FLYING_ENEMY_Y ENEMY_PROJ1_Y
        end
      end
    end
  end
  ifz FLYING_ENEMY2_DEAD
    ifnz FLYING_ENEMY2_SHOOT_TIMER
      dec FLYING_ENEMY2_SHOOT_TIMER
    end
    ifz FLYING_ENEMY2_SHOOT_TIMER
      set FLYING_ENEMY2_SHOOT_TIMER 150
      clear ENEMY_PROJ2_SHOOT_OK
      set ENEMY_PROJ2_DIR 1
      ifeq CURRENT_LEVEL 3
        ifeq PLAYER_X 44
          set ENEMY_PROJ2_SHOOT_OK 1
          clear ENEMY_PROJ2_DIR
        end
        ifeq PLAYER_X 45
          set ENEMY_PROJ2_SHOOT_OK 1
          clear ENEMY_PROJ2_DIR
        end
