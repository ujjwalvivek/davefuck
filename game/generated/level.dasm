macro check_coins
  ifz COIN_0_COLLECTED
    ifeq CURRENT_LEVEL 1
      ifeq PLAYER_Y 1
        ifeq PLAYER_X 1
          set COIN_0_COLLECTED 1
          add SCORE 10
          call audio AUDIO_PICKUP
        end
      end
    end
  end
  ifz COIN_1_COLLECTED
    ifeq CURRENT_LEVEL 1
      ifeq PLAYER_Y 4
        ifeq PLAYER_X 1
          set COIN_1_COLLECTED 1
          add SCORE 10
          call audio AUDIO_PICKUP
        end
