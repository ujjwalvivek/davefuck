macro check_gun
  ifz GUN_COLLECTED
    ifeq CURRENT_LEVEL 3
      ifeq PLAYER_Y 3
        ifeq PLAYER_X 10
          set GUN_COLLECTED 1
          call audio AUDIO_PICKUP
        end
      end
    end
  end
end

macro check_jetpack
  ifz JETPACK_0_COLLECTED
    ifeq CURRENT_LEVEL 3
      ifeq PLAYER_Y 8
        ifeq PLAYER_X 73
          set JETPACK_COLLECTED 1
          set JETPACK_FUEL JETPACK_MAX_FUEL
          set JETPACK_0_COLLECTED 1
          call audio AUDIO_PICKUP
        end
      end
    end
  end
end

macro check_key
  ifz KEY_COLLECTED
    ifeq CURRENT_LEVEL 1
      ifeq PLAYER_Y 2
        ifeq PLAYER_X 11
          set KEY_COLLECTED 1
          set DOOR_OPEN 1
          call audio AUDIO_DOOR
        end
      end
    end
    ifeq CURRENT_LEVEL 2
      ifeq PLAYER_Y 4
        ifeq PLAYER_X 13
          set KEY_COLLECTED 1
          set DOOR_OPEN 1
          call audio AUDIO_DOOR
        end
      end
    end
    ifeq CURRENT_LEVEL 3
      ifeq PLAYER_Y 8
        ifeq PLAYER_X 74
          set KEY_COLLECTED 1
          set DOOR_OPEN 1
          call audio AUDIO_DOOR
        end
      end
    end
  end
end

macro reset_enemy
  set ENEMY_TIMER ENEMY_TICK_DELAY
  set ENEMY_DIR ENEMY_START_DIR
  clear ENEMY_STEP_DONE
  clear ENEMY_DEAD
  clear ENEMY_X
  clear ENEMY_Y
end

macro reset_flying_enemy
  clear FLYING_ENEMY_DEAD
  clear FLYING_ENEMY_DIR
  clear FLYING_ENEMY_X
  clear FLYING_ENEMY_Y
  clear FLYING_ENEMY_STEP_DONE
  clear FLYING_ENEMY2_DEAD
  clear FLYING_ENEMY2_DIR
  clear FLYING_ENEMY2_X
  clear FLYING_ENEMY2_Y
  clear FLYING_ENEMY2_STEP_DONE
  clear ENEMY_PROJ1_ACTIVE
  clear ENEMY_PROJ2_ACTIVE
  set FLYING_ENEMY_SHOOT_TIMER 150
  set FLYING_ENEMY2_SHOOT_TIMER 150
  ifeq CURRENT_LEVEL 1
    set FLYING_ENEMY_DEAD 1
    set FLYING_ENEMY2_DEAD 1
  end
  ifeq CURRENT_LEVEL 2
    set FLYING_ENEMY_DEAD 1
    set FLYING_ENEMY2_DEAD 1
  end
  ifeq CURRENT_LEVEL 3
    set FLYING_ENEMY_X FLYING_ENEMY_3_0_START_X
    set FLYING_ENEMY_Y FLYING_ENEMY_3_0_START_Y
    set FLYING_ENEMY_DEAD 0
    set FLYING_ENEMY2_X FLYING_ENEMY_3_1_START_X
    set FLYING_ENEMY2_Y FLYING_ENEMY_3_1_START_Y
    set FLYING_ENEMY2_DEAD 0
  end
end

macro tick_enemy
  ifnz ENEMY_TIMER
    dec ENEMY_TIMER
  end
  ifz ENEMY_DEAD
    ifz ENEMY_TIMER
    end
  end
  ifz FLYING_ENEMY_DEAD
    ifz ENEMY_TIMER
      ifeq FLYING_ENEMY_DIR 0
        ifz FLYING_ENEMY_STEP_DONE
          inc FLYING_ENEMY_X
          inc FLYING_ENEMY_Y
          set FLYING_ENEMY_DIR 1
          set FLYING_ENEMY_STEP_DONE 1
        end
      end
      ifeq FLYING_ENEMY_DIR 1
        ifz FLYING_ENEMY_STEP_DONE
          dec FLYING_ENEMY_X
          inc FLYING_ENEMY_Y
          set FLYING_ENEMY_DIR 2
          set FLYING_ENEMY_STEP_DONE 1
        end
      end
      ifeq FLYING_ENEMY_DIR 2
        ifz FLYING_ENEMY_STEP_DONE
          dec FLYING_ENEMY_X
          dec FLYING_ENEMY_Y
          set FLYING_ENEMY_DIR 3
          set FLYING_ENEMY_STEP_DONE 1
        end
      end
      ifeq FLYING_ENEMY_DIR 3
        ifz FLYING_ENEMY_STEP_DONE
          inc FLYING_ENEMY_X
          dec FLYING_ENEMY_Y
          set FLYING_ENEMY_DIR 0
          set FLYING_ENEMY_STEP_DONE 1
        end
      end
    end
  end
  ifz FLYING_ENEMY2_DEAD
    ifz ENEMY_TIMER
      ifeq FLYING_ENEMY2_DIR 0
        ifz FLYING_ENEMY2_STEP_DONE
          inc FLYING_ENEMY2_X
          inc FLYING_ENEMY2_Y
          set FLYING_ENEMY2_DIR 1
          set FLYING_ENEMY2_STEP_DONE 1
        end
      end
      ifeq FLYING_ENEMY2_DIR 1
        ifz FLYING_ENEMY2_STEP_DONE
          dec FLYING_ENEMY2_X
          inc FLYING_ENEMY2_Y
          set FLYING_ENEMY2_DIR 2
          set FLYING_ENEMY2_STEP_DONE 1
        end
      end
      ifeq FLYING_ENEMY2_DIR 2
        ifz FLYING_ENEMY2_STEP_DONE
          dec FLYING_ENEMY2_X
          dec FLYING_ENEMY2_Y
          set FLYING_ENEMY2_DIR 3
          set FLYING_ENEMY2_STEP_DONE 1
        end
      end
      ifeq FLYING_ENEMY2_DIR 3
        ifz FLYING_ENEMY2_STEP_DONE
          inc FLYING_ENEMY2_X
          dec FLYING_ENEMY2_Y
          set FLYING_ENEMY2_DIR 0
          set FLYING_ENEMY2_STEP_DONE 1
        end
      end
    end
  end
  ifz ENEMY_TIMER
    set ENEMY_TIMER ENEMY_TICK_DELAY
    clear ENEMY_STEP_DONE
    clear FLYING_ENEMY_STEP_DONE
    clear FLYING_ENEMY2_STEP_DONE
  end
end

macro check_projectile_enemy
  ifnz PROJECTILE_ACTIVE
    ifz ENEMY_DEAD
    end
    ifz FLYING_ENEMY_DEAD
      ifeq_cell FLYING_ENEMY_X PROJECTILE_X
        ifeq_cell FLYING_ENEMY_Y PROJECTILE_Y
          set FLYING_ENEMY_DEAD 1
          clear PROJECTILE_ACTIVE
          add SCORE 50
          call audio AUDIO_HIT
        end
      end
    end
    ifz FLYING_ENEMY2_DEAD
      ifeq_cell FLYING_ENEMY2_X PROJECTILE_X
        ifeq_cell FLYING_ENEMY2_Y PROJECTILE_Y
          set FLYING_ENEMY2_DEAD 1
          clear PROJECTILE_ACTIVE
          add SCORE 50
          call audio AUDIO_HIT
        end
      end
    end
  end
end

macro check_enemy_hit
  ifz GAME_WIN
    ifz GAME_DEAD
      ifz ENEMY_DEAD
      end
      ifz FLYING_ENEMY_DEAD
        ifeq_cell PLAYER_Y FLYING_ENEMY_Y
          ifeq_cell PLAYER_X FLYING_ENEMY_X
            set GAME_DEAD 1
            call audio AUDIO_DEATH
          end
          inc PLAYER_X
          ifeq_cell PLAYER_X FLYING_ENEMY_X
            ifeq PLAYER_SUB_X 8
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 9
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 10
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 11
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 12
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 13
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 14
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 15
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
          end
          dec PLAYER_X
        end
      end
      ifz FLYING_ENEMY2_DEAD
        ifeq_cell PLAYER_Y FLYING_ENEMY2_Y
          ifeq_cell PLAYER_X FLYING_ENEMY2_X
            set GAME_DEAD 1
            call audio AUDIO_DEATH
          end
          inc PLAYER_X
          ifeq_cell PLAYER_X FLYING_ENEMY2_X
            ifeq PLAYER_SUB_X 8
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 9
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 10
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 11
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 12
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 13
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 14
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
            ifeq PLAYER_SUB_X 15
              set GAME_DEAD 1
              call audio AUDIO_DEATH
            end
          end
          dec PLAYER_X
        end
      end
    end
  end
end

